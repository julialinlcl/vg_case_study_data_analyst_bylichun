    create  table
      "casestudy"."marts"."mart_branch_performance__summary__dbt_tmp"
  
    as (
      with loans as (
    select
        c.branch_id,
        date_trunc('month', l.approval_rejection_date) as month,
        l.loan_count,
        l.total_loan_amount_eur
    from "casestudy"."intermediate"."stg_staging_intermediate__loans" l
    join "casestudy"."intermediate"."stg_staging_intermediate__customers" c
        on l.customer_id = c.customer_id
    where l.loan_status = 'approved'
),

transactions as (
    select
        c.branch_id,
        date_trunc('month', t.transaction_date) as month,
        sum(t.transaction_amount * fx.fx_rate) as total_transaction_eur,
        count(*) as transaction_count
    from "casestudy"."intermediate"."stg_staging_intermediate__transactions" t
    join "casestudy"."intermediate"."stg_staging_intermediate__accounts" a
        on t.account_id = a.account_id
    join "casestudy"."intermediate"."stg_staging_intermediate__customers" c
        on a.customer_id = c.customer_id
    join "casestudy"."intermediate"."stg_staging_intermediate__fx_rates" fx
        on t.transaction_currency = fx.currency_iso_code
        and date_trunc('day', t.transaction_date) = fx.fx_rate_date
    group by c.branch_id, date_trunc('month', t.transaction_date)
)

select
    coalesce(l.branch_id, t.branch_id) as branch_id,
    coalesce(l.month, t.month) as month,
    coalesce(sum(l.loan_count), 0) as total_loan_count,
    coalesce(sum(l.total_loan_amount_eur), 0) as total_loan_amount_eur,
    coalesce(sum(t.transaction_count), 0) as total_transaction_count,
    coalesce(sum(t.total_transaction_eur), 0) as total_transaction_amount_eur
from loans l
full outer join transactions t
    on l.branch_id = t.branch_id and l.month = t.month
group by coalesce(l.branch_id, t.branch_id), coalesce(l.month, t.month)
order by branch_id, month
    );
  
  
