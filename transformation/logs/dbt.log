    create  table
      "casestudy"."marts"."mart_loan__summary__dbt_tmp"
  
    as (
      with loans_with_currency as (
    select
        l.loan_id,
        l.loan_type,
        l.loan_status,
        date_trunc('month', l.approval_rejection_date) as approval_month,
